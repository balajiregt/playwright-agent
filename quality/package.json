{
  "name": "@playwright-agent/quality",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Internal Playwright Agent module: requirement intake, assertion claim checks, behavioral mutation verification and the evidence report viewer.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "intake": "node --import tsx src/intake-cli.ts",
    "claims": "node --import tsx src/claims-cli.ts",
    "mutation": "node --import tsx src/mutation-cli.ts",
    "portal": "node --import tsx src/portal-cli.ts",
    "eval": "node --import tsx src/evaluation-cli.ts",
    "security:staged": "node scripts/security-gate.mjs",
    "security:hooks": "node scripts/install-security-hook.mjs",
    "security:check": "python3 scripts/security_audit.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "^2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/balajiregt/playwright-agent.git"
  },
  "license": "MIT"
}
